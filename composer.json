{
  "name": "fr4nck/wp-piwigo-display",
  "description": "WordPress plugin for displaying Piwigo albums.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": { "php": ">=8.1" },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "config": {
    "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true },
    "sort-packages": true
  },
  "scripts": {
    "lint": "find . -type f -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
    "compatibility": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 8.1- --extensions=php --ignore=vendor .",
    "security:entrypoints": "php tests/security-entrypoints.php",
    "security:dataflows": "php tests/security-dataflows.php",
    "security": ["@security:entrypoints", "@security:dataflows"],
    "accessibility": "php tests/accessibility-ui.php",
    "test:frontend": [
      "php tests/frontend-render-resilience.php",
      "php tests/transparent-background.php",
      "php tests/api-health-diagnostics.php",
      "php tests/justified-layout.php",
      "php tests/collage-layout.php",
      "php tests/photo-text-layout.php",
      "php tests/svg-mask-sanitizer.php",
      "php tests/shapes.php",
      "node tests/tinymce-preview.js"
    ],
    "test:package-assets": "php tests/package-assets.php",
    "standards": "phpcs --standard=phpcs.xml.dist",
    "standards:settings": "phpcs --standard=phpcs.xml.dist includes/class-wpd-settings.php",
    "standards:diagnostic": "phpcs --standard=phpcs.xml.dist includes/class-wpd-diagnostic.php",
    "standards:service-api": "phpcs --standard=phpcs.xml.dist includes/class-wpd-service-api.php",
    "standards:service-account": "phpcs --standard=phpcs.xml.dist includes/class-wpd-service-account.php",
    "standards:services": "phpcs --standard=phpcs.xml.dist includes/class-wpd-service-api.php includes/class-wpd-service-account.php",
    "standards:checked": "phpcs --standard=phpcs.xml.dist wp-piwigo-display.php includes/class-wpd-gutenberg-parity.php includes/class-wpd-shapes.php includes/class-wpd-svg-mask-sanitizer.php includes/class-wpd-slider-transitions.php includes/class-wpd-classic-editor.php includes/class-wpd-block.php includes/class-wpd-masonry.php includes/class-wpd-justified.php includes/class-wpd-collage.php includes/class-wpd-photo-text.php includes/class-wpd-composer-parity.php includes/class-wpd-cache.php includes/class-wpd-api-metrics.php includes/class-wpd-renderer.php includes/class-wpd-api.php includes/class-wpd-shortcode.php includes/class-wpd-settings.php includes/class-wpd-diagnostic.php includes/class-wpd-service-api.php includes/class-wpd-service-account.php includes/class-wpd-plugin.php",
    "standards:report": "phpcs --standard=phpcs.xml.dist --report=summary",
    "standards:fix": "phpcbf --standard=phpcs.xml.dist"
  }
}
