{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-piwigo-display/gallery",
  "version": "3.1.0-dev",
  "title": "Piwigo Display",
  "category": "media",
  "icon": "format-gallery",
  "description": "Insère une galerie, un diaporama, un mur Masonry, une galerie justifiée, un collage ou un texte rempli de photos Piwigo.",
  "textdomain": "wp-piwigo-display",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "attributes": {
    "albumId":{"type":"string"}, "displayType":{"type":"string"},
    "preset":{"type":"string","default":""}, "piwigoUrl":{"type":"string","default":""},
    "recursive":{"type":"boolean"}, "depth":{"type":"number"}, "limit":{"type":"number"}, "max":{"type":"number"}, "latest":{"type":"number"}, "random":{"type":"number"},
    "sort":{"type":"string"}, "order":{"type":"string"}, "orientations":{"type":"array"},
    "caption":{"type":"string"}, "lightbox":{"type":"boolean"}, "rounded":{"type":"boolean"}, "transparentBackground":{"type":"boolean","default":false}, "style":{"type":"string"},
    "shape":{"type":"string","default":"rectangle"}, "radius":{"type":"number","default":0},
    "autoplay":{"type":"boolean"}, "interval":{"type":"number"}, "speed":{"type":"number"}, "transition":{"type":"string","default":"slide"}, "direction":{"type":"string","default":"ltr"}, "ratio":{"type":"string"}, "width":{"type":"string","default":"100%"}, "height":{"type":"string"}, "align":{"type":"string"}, "fit":{"type":"string"}, "navigation":{"type":"string"},
    "masonryColumns":{"type":"number","default":4}, "masonryGap":{"type":"number","default":16},
    "justifiedRowHeight":{"type":"number","default":220}, "justifiedGap":{"type":"number","default":8},
    "collageSeed":{"type":"string","default":"0"}, "collageRotation":{"type":"number","default":6}, "collageSpread":{"type":"number","default":18}, "collageOverlap":{"type":"number","default":12}, "collageSize":{"type":"number","default":220}, "collageVariation":{"type":"number","default":20},
    "photoText":{"type":"string","default":"PÊLE-MÊLE"}, "photoTextSeed":{"type":"string","default":"0"}, "photoTextFont":{"type":"string","default":"inherit"}, "photoTextWeight":{"type":"number","default":800}, "photoTextSize":{"type":"number","default":230}, "photoTextLetterSpacing":{"type":"number","default":0}, "photoTextLineHeight":{"type":"number","default":100}, "photoTextMaxWidth":{"type":"number","default":100}, "photoTextAlign":{"type":"string","default":"center"}, "photoTextFillMode":{"type":"string","default":"grid"}, "photoTextDensity":{"type":"number","default":100}, "photoTextRotation":{"type":"number","default":6}, "photoTextSpread":{"type":"number","default":18}, "photoTextOutline":{"type":"boolean","default":true}, "photoTextOutlineWidth":{"type":"number","default":3}, "photoTextOutlineColor":{"type":"string","default":"#ffffff"}, "photoTextBackground":{"type":"string","default":"transparent"}, "photoTextMaxImages":{"type":"number","default":20},
    "tag":{"type":"string"}, "tags":{"type":"string"}, "tagMode":{"type":"string"}
  },
  "supports":{"html":false}
}
