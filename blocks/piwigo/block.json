{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-piwigo-display/gallery",
  "version": "1.12.0",
  "title": "WP Piwigo Display",
  "category": "media",
  "icon": "format-gallery",
  "description": "Insère une galerie, un diaporama ou un mur Masonry Piwigo.",
  "textdomain": "wp-piwigo-display",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "attributes": {
    "albumId":{"type":"string"}, "displayType":{"type":"string"},
    "preset":{"type":"string","default":""}, "piwigoUrl":{"type":"string","default":""},
    "recursive":{"type":"boolean"}, "depth":{"type":"number"}, "limit":{"type":"number"}, "max":{"type":"number"}, "latest":{"type":"number"}, "random":{"type":"number"},
    "sort":{"type":"string"}, "order":{"type":"string"}, "orientations":{"type":"array"},
    "caption":{"type":"string"}, "lightbox":{"type":"boolean"}, "rounded":{"type":"boolean"}, "transparentBackground":{"type":"boolean","default":false}, "style":{"type":"string"},
    "shape":{"type":"string","default":"rectangle"}, "radius":{"type":"number","default":0},
    "autoplay":{"type":"boolean"}, "interval":{"type":"number"}, "speed":{"type":"number"}, "transition":{"type":"string","default":"slide"}, "direction":{"type":"string","default":"ltr"}, "ratio":{"type":"string"}, "width":{"type":"string","default":"100%"}, "height":{"type":"string"}, "align":{"type":"string"}, "fit":{"type":"string"}, "navigation":{"type":"string"},
    "masonryColumns":{"type":"number","default":4}, "masonryGap":{"type":"number","default":16},
    "tag":{"type":"string"}, "tags":{"type":"string"}, "tagMode":{"type":"string"}
  },
  "supports":{"html":false}
}
